{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "vite": true,
  "entry": ["src/main.ts", "src/shell.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "yargs",
    "prettier",
    "pm2",
    "madge",
    "assemblyscript",
    "npm-check-updates",
    "@types/*"
  ],
  "ignore": [
    "src/utils/rand.ts",
    "src/persist/**/migrations/*.ts",
    "src/persist/**/schema.ts"
  ]
}
